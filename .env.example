# ==============================================================================
# Everything Gemini and Antigravity (EGA) — Environment Configuration Template
# ==============================================================================
# Set any of these variables in your system/shell environment or .env file.
# The EGA plugin inherits them automatically when the corresponding MCP servers
# or lifecycle hooks are activated.

# ------------------------------------------------------------------------------
# 1. EGA Lifecycle & Hook Automation Profile
# ------------------------------------------------------------------------------
# Master switch for all EGA safety and quality lifecycle hooks (true / false)
EGA_HOOKS_ENABLED=true

# Hook strictness profile:
# - minimal: Core safety only (blocks dangerous commands, keeps build clean)
# - standard: (Default) Full safety, doc warnings, format/typecheck on stop
# - strict: Adds strict fact-forcing gates and deep checks on every edit
EGA_HOOK_PROFILE=standard

# Comma-separated list of hook IDs to selectively disable (e.g., pre:write:doc-file-warning)
# EGA_DISABLED_HOOKS=pre:write:doc-file-warning,stop:check-console-log

# ------------------------------------------------------------------------------
# 2. Developer & Issue Tracking MCP Servers
# ------------------------------------------------------------------------------
# GitHub MCP: Pull requests, issues, repo management
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Atlassian Jira MCP: Issue tracking, search, comments, status transitions
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Atlassian Confluence MCP: Documentation search and page management
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# ------------------------------------------------------------------------------
# 3. Web Scraping, Search & AI Agents
# ------------------------------------------------------------------------------
# Firecrawl MCP: Clean markdown web scraping and site crawling
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Exa Neural Search MCP: Semantic web and code search
EXA_API_KEY=your_exa_api_key_here

# Browserbase MCP: Headless cloud browser infrastructure
BROWSERBASE_API_KEY=your_browserbase_api_key_here

# Browser-Use MCP: Autonomous cloud web browsing agent
BROWSER_USE_API_KEY=your_browser_use_api_key_here

# ------------------------------------------------------------------------------
# 4. Databases, Cloud & Architecture
# ------------------------------------------------------------------------------
# Supabase MCP: Database migrations and table queries
SUPABASE_PROJECT_REF=your_supabase_project_ref_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# CodeScene MCP: Structural Code Health and technical debt metrics
CS_ACCESS_TOKEN=your_codescene_access_token_here

# Fal.ai MCP: Media, audio, video, and image generation
FAL_KEY=your_fal_ai_api_key_here

# Memxus MCP: Universal persistent cross-agent memory
MEMXUS_API_KEY=your_memxus_api_key_here

# EvalView MCP: AI agent regression testing
OPENAI_API_KEY=your_openai_api_key_here

# Mnemosyne OS MCP: Local desktop memory vaults
MNEMO_VAULTS=default
