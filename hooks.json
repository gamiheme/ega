{
  "ega-command-safety": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode pre-tool-use --hook pre:bash:dispatcher",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ega-config-protection": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode pre-tool-use --hook pre:config-protection",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ega-doc-file-warning": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode pre-tool-use --hook pre:write:doc-file-warning",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ega-gateguard-strict": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode pre-tool-use --hook pre:edit-write:gateguard-fact-force",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ega-post-edit-accumulator": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode post-tool-use --hook post:edit:accumulator",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ega-stop-format-typecheck": {
    "enabled": true,
    "Stop": [
      {
        "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode stop --hook stop:format-typecheck",
        "timeout": 60
      }
    ]
  },
  "ega-stop-check-console-log": {
    "enabled": true,
    "Stop": [
      {
        "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode stop --hook stop:check-console-log",
        "timeout": 15
      }
    ]
  },
  "ega-cost-tracker": {
    "enabled": false,
    "Stop": [
      {
        "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode stop --hook stop:cost-tracker",
        "timeout": 15
      }
    ]
  },
  "ega-desktop-notify": {
    "enabled": false,
    "Stop": [
      {
        "command": "node ./scripts/hooks/antigravity-hook-bridge.js --mode stop --hook stop:desktop-notify",
        "timeout": 15
      }
    ]
  }
}
